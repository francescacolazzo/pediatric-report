<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Informe Pediátrico</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: "Helvetica Neue", Arial, sans-serif;
      font-size: 10.5pt;
      color: #1a1a1a;
      background: #fff;
    }

    /* ── Page wrapper ── */
    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 12mm 16mm 20mm 16mm;
      position: relative;
    }

    /* ── Header ── */
    .report-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #C8003B;
      padding-bottom: 10px;
      margin-bottom: 16px;
    }

    /* ── Logo GAES Junior ── */
    .logo-block { display: flex; flex-direction: column; gap: 4px; }
    .logo-svg-wrap svg { display: block; }
    .informe-label {
      font-size: 11pt;
      font-weight: 900;
      color: #C8003B;
      letter-spacing: 0.03em;
      margin-top: 4px;
      text-transform: uppercase;
    }

    /* ── Header DX — dati negozio e audiologo ── */
    .header-meta {
      text-align: right;
      font-size: 8pt;
      color: #555;
      line-height: 1.65;
    }
    .header-meta .centre-name {
      font-weight: 800;
      font-size: 9pt;
      color: #C8003B;
    }
    .header-meta .pro-name {
      font-weight: 700;
      font-size: 8.5pt;
      color: #1a1a1a;
    }
    .header-meta .meta-sep {
      border-top: 1px solid #e0e0e0;
      margin: 4px 0;
    }

    /* ── Greeting bar ── */
    .greeting-bar {
      background: #fdf0f3;
      border-left: 4px solid #C8003B;
      padding: 6px 12px;
      font-size: 10pt;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 14px;
    }

    /* ── Page number ── */
    .page-num {
      position: absolute;
      bottom: 8mm;
      right: 16mm;
      font-size: 7.5pt;
      color: #bbb;
    }

    /* ── Section ── */
    .section { margin-bottom: 18px; }
    .section-title {
      font-size: 9.5pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-bottom: 1.5px solid #C8003B;
      padding-bottom: 3px;
      margin-bottom: 9px;
      color: #1a1a1a;
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .section-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #C8003B;
      color: #fff;
      font-size: 7.5pt;
      font-weight: 800;
      width: 17px;
      height: 17px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    p { margin-bottom: 5px; line-height: 1.55; }

    /* ── Two-column grid ── */
    .col2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    /* ── Ear block ── */
    .ear-block-title {
      font-size: 8.5pt;
      font-weight: 700;
      text-align: center;
      background: #C8003B;
      color: #fff;
      padding: 4px 8px;
      border-radius: 3px 3px 0 0;
    }
    .ear-inner {
      border: 1px solid #e0b0bb;
      border-top: none;
      border-radius: 0 0 4px 4px;
      padding: 8px 10px;
      background: #fffafb;
    }
    .ear-row {
      display: flex;
      justify-content: space-between;
      padding: 3px 0;
      border-bottom: 1px solid #f0e0e4;
      font-size: 9pt;
    }
    .ear-row:last-child { border-bottom: none; }
    .ear-row .lbl { color: #777; font-size: 8.5pt; }
    .ear-row .val { font-weight: 600; }
    .ear-not-evaluated {
      color: #bbb;
      font-style: italic;
      font-size: 8.5pt;
      text-align: center;
      padding: 12px 0;
    }

    /* ── Info row ── */
    .info-row { font-size: 9pt; margin-bottom: 4px; }
    .info-row .lbl { color: #777; }
    .info-row .val { font-weight: 600; }

    /* ── Tables ── */
    table { width: 100%; border-collapse: collapse; margin-top: 6px; font-size: 9pt; }
    th {
      background: #C8003B;
      color: #fff;
      font-weight: 700;
      padding: 5px 8px;
      border: 1px solid #C8003B;
      text-align: center;
      font-size: 8.5pt;
    }
    td { padding: 5px 8px; border: 1px solid #e0e0e0; text-align: center; }
    td.label {
      text-align: left;
      font-weight: 600;
      color: #444;
      background: #fdf5f6;
      border-right: 1px solid #e0b0bb;
    }
    tr:nth-child(even) td { background: #fafafa; }
    tr:nth-child(even) td.label { background: #faedef; }

    /* ── Ling ── */
    .ling-heard     { color: #1a7a1a; font-weight: 800; font-size: 13pt; line-height: 1; }
    .ling-not-heard { color: #C8003B; font-weight: 800; font-size: 13pt; line-height: 1; }
    .ling-legend {
      display: flex;
      gap: 16px;
      margin-top: 5px;
      font-size: 8pt;
      color: #555;
    }
    .ling-legend span { display: flex; align-items: center; gap: 4px; }

    /* ── COSI ── */
    .cosi-needs { border: 1px solid #e0b0bb; border-radius: 4px; overflow: hidden; margin-top: 6px; }
    .cosi-need {
      padding: 5px 10px;
      border-bottom: 1px dashed #e8c8ce;
      font-size: 9pt;
    }
    .cosi-need:last-child { border-bottom: none; }
    .cosi-need .need-num { font-weight: 700; color: #C8003B; margin-right: 5px; }

    /* ── Fitting ── */
    .fitting-flag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #C8003B;
      color: #fff;
      font-size: 8pt;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 3px;
      margin-top: 8px;
    }

    /* ── Pass / No Pass badges ── */
    .badge-pass   { background: #d1fae5; color: #065f46; padding: 2px 8px; border-radius: 3px; font-weight: 700; font-size: 8pt; }
    .badge-nopass { background: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 3px; font-weight: 700; font-size: 8pt; }

    /* ── Conclusions ── */
    .conclusion-text {
      font-size: 9.5pt;
      line-height: 1.7;
      text-align: justify;
    }
    .pending-box {
      border-left: 4px solid #C8003B;
      padding: 6px 12px;
      background: #fff0f2;
      margin-top: 10px;
      font-size: 9pt;
      font-style: italic;
      color: #7a0020;
    }

    /* ── Standard text ── */
    .std-text {
      font-size: 8.5pt;
      color: #666;
      line-height: 1.55;
      margin-bottom: 7px;
      font-style: italic;
    }

    /* ── Final notes ── */
    .final-text { white-space: pre-wrap; font-size: 9.5pt; line-height: 1.6; }
    .closing-formula { margin-top: 14px; font-style: italic; font-size: 9pt; color: #555; }
    .signature-block {
      margin-top: 24px;
      padding-top: 8px;
      border-top: 1px solid #ccc;
      font-size: 9pt;
    }
    .sig-name  { font-weight: 700; font-size: 10pt; color: #1a1a1a; }
    .sig-title { color: #777; font-style: italic; margin-top: 2px; }

    /* ── Print ── */
    @media print {
      .page { padding: 10mm 14mm 18mm 14mm; }
      .section { page-break-inside: avoid; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- ══ HEADER ══════════════════════════════════════════════ -->
  <div class="report-header">

    <!-- Logo GAES Junior (immagine reale) + etichetta -->
    <div class="logo-block">
      <img src="{{ amplifonLogoB64 }}" alt="GAES Junior — una marca amplifon" style="height:48px;display:block;">
      <div class="informe-label">Informe Pediátrico</div>
    </div>

    <!-- Dati negozio + audiologo (mock SF) -->
    <div class="header-meta">
      <div class="centre-name">{{ centre.name }}</div>
      <div>{{ centre.address }}</div>
      <div>{{ centre.city }}</div>
      <div>{{ centre.phone }}</div>
      <div class="meta-sep"></div>
      <div class="pro-name">{{ professional.fullName }}</div>
      <div>{{ professional.title }}</div>
      <div class="meta-sep"></div>
      <div style="color:#aaa;font-size:7.5pt">Generado: {{ generatedAt }} &nbsp;·&nbsp; Pac.: {{ patientId }}</div>
    </div>
  </div>

  <!-- ══ GREETING ═════════════════════════════════════════════ -->
  <div class="greeting-bar">{{ introduction.greeting }},</div>

  <!-- ══ COLLABORATIVENESS ════════════════════════════════════ -->
  <div class="section">
    <div class="section-title"><span class="section-num">1</span>Collaborativeness</div>
    <p>{{ collaborativeness.sentence }}</p>
  </div>

  <!-- ══ THE EAR ══════════════════════════════════════════════ -->
  {% if ear %}
  <div class="section">
    <div class="section-title"><span class="section-num">2</span>The Ear</div>
    <div class="col2">

      {% if ear.left %}
      <div>
        <div class="ear-block-title">Left Ear</div>
        <div class="ear-inner">
          <div class="ear-row"><span class="lbl">Otoscopy</span><span class="val">{{ ear.left.otoscopyLabel }}</span></div>
          <div style="font-size:7.5pt;font-weight:700;color:#C8003B;text-transform:uppercase;letter-spacing:.06em;padding:5px 0 2px">Tympanometry</div>
          <div class="ear-row"><span class="lbl">Type</span><span class="val">{{ ear.left.tympanometryLabel }}</span></div>
          <div class="ear-row"><span class="lbl">Pressure</span><span class="val">{{ ear.left.tympanometryPressure }} daPa</span></div>
        </div>
      </div>
      {% else %}
      <div>
        <div class="ear-block-title">Left Ear</div>
        <div class="ear-inner"><div class="ear-not-evaluated">Not evaluated</div></div>
      </div>
      {% endif %}

      {% if ear.right %}
      <div>
        <div class="ear-block-title">Right Ear</div>
        <div class="ear-inner">
          <div class="ear-row"><span class="lbl">Otoscopy</span><span class="val">{{ ear.right.otoscopyLabel }}</span></div>
          <div style="font-size:7.5pt;font-weight:700;color:#C8003B;text-transform:uppercase;letter-spacing:.06em;padding:5px 0 2px">Tympanometry</div>
          <div class="ear-row"><span class="lbl">Type</span><span class="val">{{ ear.right.tympanometryLabel }}</span></div>
          <div class="ear-row"><span class="lbl">Pressure</span><span class="val">{{ ear.right.tympanometryPressure }} daPa</span></div>
        </div>
      </div>
      {% else %}
      <div>
        <div class="ear-block-title">Right Ear</div>
        <div class="ear-inner"><div class="ear-not-evaluated">Not evaluated</div></div>
      </div>
      {% endif %}

    </div>
  </div>
  {% endif %}

  <!-- ══ EVOKED POTENTIALS ════════════════════════════════════ -->
  {% if tests and tests.evokedPotentials %}
  <div class="section">
    <div class="section-title"><span class="section-num">3</span>Evoked Potentials</div>
    <p class="std-text">{{ tests.evokedPotentials.standardText }}</p>
    <p class="info-row">
      <span class="lbl">Performed by: </span>
      <span class="val">{{ tests.evokedPotentials.performerLabel }}{% if tests.evokedPotentials.specialistDate %} — {{ tests.evokedPotentials.specialistDate }}{% endif %}</span>
    </p>
    <table>
      <thead><tr>
        <th style="width:36%"></th>
        {% if tests.evokedPotentials.left %}<th>Left Ear</th>{% endif %}
        {% if tests.evokedPotentials.right %}<th>Right Ear</th>{% endif %}
      </tr></thead>
      <tbody>
        <tr>
          <td class="label">Decibels</td>
          {% if tests.evokedPotentials.left %}<td>{{ tests.evokedPotentials.left.db }} dB</td>{% endif %}
          {% if tests.evokedPotentials.right %}<td>{{ tests.evokedPotentials.right.db }} dB</td>{% endif %}
        </tr>
        <tr>
          <td class="label">Pass / No Pass</td>
          {% if tests.evokedPotentials.left %}
            <td>{% if tests.evokedPotentials.left.pass %}<span class="badge-pass">Pass</span>{% else %}<span class="badge-nopass">No Pass</span>{% endif %}</td>
          {% endif %}
          {% if tests.evokedPotentials.right %}
            <td>{% if tests.evokedPotentials.right.pass %}<span class="badge-pass">Pass</span>{% else %}<span class="badge-nopass">No Pass</span>{% endif %}</td>
          {% endif %}
        </tr>
      </tbody>
    </table>
  </div>
  {% endif %}

  <!-- ══ LING TEST ════════════════════════════════════════════ -->
  {% if tests and tests.lingTest %}
  <div class="section">
    <div class="section-title"><span class="section-num">4</span>Ling Test</div>
    <p class="std-text">{{ tests.lingTest.standardText }}</p>
    <table>
      <thead><tr>
        <th style="width:20%"></th>
        {% for dist in tests.lingTest.distances %}<th>{{ dist }}</th>{% endfor %}
      </tr></thead>
      <tbody>
        {% for row in tests.lingTest.rows %}
        <tr>
          <td class="label">{{ row.sound }}</td>
          {% for cell in row.cells %}
            <td>{% if cell.heard %}<span class="ling-heard">●</span>{% else %}<span class="ling-not-heard">✕</span>{% endif %}</td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <div class="ling-legend">
      <span><span class="ling-heard">●</span> Heard</span>
      <span><span class="ling-not-heard">✕</span> Not heard</span>
    </div>
  </div>
  {% endif %}

  <!-- ══ QUESTIONNAIRE ════════════════════════════════════════ -->
  {% if questionnaire %}
  <div class="section">
    <div class="section-title"><span class="section-num">5</span>Questionnaire</div>
    <p>{{ questionnaire.sentence }}</p>
    {% if questionnaire.cosi %}
      <p class="info-row" style="margin-top:5px"><span class="lbl">Session date: </span><span class="val">{{ questionnaire.cosi.sessionDate }}</span></p>
      <div class="cosi-needs">
        {% for need in questionnaire.cosi.needs %}
          <div class="cosi-need"><span class="need-num">{{ loop.index }}.</span>{{ need }}</div>
        {% endfor %}
      </div>
    {% else %}
      {% if questionnaire.notes %}<p style="margin-top:5px;font-size:9.5pt">{{ questionnaire.notes }}</p>{% endif %}
    {% endif %}
  </div>
  {% endif %}

  <!-- ══ FITTING INFO ═════════════════════════════════════════ -->
  {% if fitting %}
  <div class="section">
    <div class="section-title"><span class="section-num">6</span>Fitting Info</div>
    <table>
      <thead><tr>
        <th style="width:36%"></th>
        {% if fitting.left %}<th>Left Ear</th>{% endif %}
        {% if fitting.right %}<th>Right Ear</th>{% endif %}
      </tr></thead>
      <tbody>
        <tr>
          <td class="label">Tipo de audífono</td>
          {% if fitting.left %}<td>{{ fitting.left.hearingAidLabel }}<br><span style="color:#aaa;font-size:7.5pt">{{ fitting.left.hearingAidCode }}</span></td>{% endif %}
          {% if fitting.right %}<td>{{ fitting.right.hearingAidLabel }}<br><span style="color:#aaa;font-size:7.5pt">{{ fitting.right.hearingAidCode }}</span></td>{% endif %}
        </tr>
        {% if (fitting.left and fitting.left.earmoldLabel) or (fitting.right and fitting.right.earmoldLabel) %}
        <tr>
          <td class="label">Tipo de molde</td>
          {% if fitting.left %}<td>{{ fitting.left.earmoldLabel or '—' }}{% if fitting.left.earmoldCode %}<br><span style="color:#aaa;font-size:7.5pt">{{ fitting.left.earmoldCode }}</span>{% endif %}</td>{% endif %}
          {% if fitting.right %}<td>{{ fitting.right.earmoldLabel or '—' }}{% if fitting.right.earmoldCode %}<br><span style="color:#aaa;font-size:7.5pt">{{ fitting.right.earmoldCode }}</span>{% endif %}</td>{% endif %}
        </tr>
        {% endif %}
      </tbody>
    </table>
    {% if (fitting.left and fitting.left.remRecdVerified) or (fitting.right and fitting.right.remRecdVerified) %}
      <div><span class="fitting-flag">✓ Fitted with REM/RECD</span></div>
    {% endif %}
  </div>
  {% endif %}

  <!-- ══ CONCLUSIONES ═════════════════════════════════════════ -->
  {% if conclusions %}
  <div class="section">
    <div class="section-title"><span class="section-num">7</span>Conclusiones</div>
    <p class="conclusion-text">{{ conclusions.phrase }}</p>
    {% if conclusions.pendingText %}
      <div class="pending-box">{{ conclusions.pendingText }}</div>
    {% endif %}
  </div>
  {% endif %}

  <!-- ══ FINAL NOTES ══════════════════════════════════════════ -->
  <div class="section">
    <div class="section-title"><span class="section-num">8</span>Final Notes</div>
    <p class="final-text">{{ finalNotes.text }}</p>
    <p class="closing-formula">{{ finalNotes.closingFormula }}</p>
    <div class="signature-block">
      <div class="sig-name">{{ finalNotes.signature }}</div>
      <div class="sig-title">Especialista en audiología pediátrica</div>
    </div>
  </div>

  <div class="page-num">GAES Junior · Informe Pediátrico</div>

</div>
</body>
</html>
