{
  "name": "pediatric-report",
  "version": "1.0.0",
  "description": "Informe Médico Pediátrico — Node.js API",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit"
  },
  "dependencies": {
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "nunjucks": "^3.2.4",
    "puppeteer": "^25.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
